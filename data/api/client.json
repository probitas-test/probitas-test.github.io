          "id": 50,
          "name": "ok",
          "variant": "declaration",
          "kind": 1024,
          "flags": {
            "isReadonly": true
          },
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Whether the operation succeeded.\n\nFor HTTP responses, this corresponds to status 200-299.\nFor database operations, this indicates successful execution.\nAlways "
              },
              {
                "kind": "code",
                "text": "`false`"
              },
              {
                "kind": "text",
                "text": " when "
              },
              {
                "kind": "code",
                "text": "`processed`"
              },
              {
                "kind": "text",
                "text": " is "
              },
              {
                "kind": "code",
                "text": "`false`"
              },
              {
                "kind": "text",
                "text": "."
              }
            ]
          },
          "type": {
            "type": "intrinsic",
            "name": "boolean"
          }
        },
        {
          "id": 49,
          "name": "processed",
          "variant": "declaration",
          "kind": 1024,
          "flags": {
            "isReadonly": true
          },
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Whether the operation was processed by the server.\n\n- "
              },
              {
                "kind": "code",
                "text": "`true`"
              },
              {
                "kind": "text",
                "text": ": Server received and processed the request (success or error response)\n- "
              },
              {
                "kind": "code",
                "text": "`false`"
              },
              {
                "kind": "text",
                "text": ": Request failed before reaching the server (network error, timeout, etc.)\n\nUse this to distinguish between \"server returned an error\" and \"couldn't reach server\"."
              }
            ]
          },
          "type": {
            "type": "intrinsic",
            "name": "boolean"
          }
        }
