      "name": "BuilderStepContext",
      "variant": "declaration",
      "kind": 2097152,
      "flags": {},
      "comment": {
        "summary": [
          {
            "kind": "text",
            "text": "Execution context provided to steps, resources, and setup hooks.\n\nThe context provides access to:\n- Previous step results with full type inference\n- All accumulated results as a typed tuple\n- Named resources registered with "
          },
          {
            "kind": "code",
            "text": "`.resource()`"
          },
          {
            "kind": "text",
            "text": "\n- Shared storage for cross-step communication\n- Abort signal for timeout and cancellation handling"
          }
        ],
        "blockTags": [
          {
            "tag": "@example",
            "name": "Accessing previous result",
            "content": [
              {
                "kind": "code",
                "text": "```ts\nimport { scenario } from \"@probitas-test/builder\";\n\nscenario(\"Chained Steps\")\n  .step(\"First\", () => ({ id: 123 }))\n  .step(\"Second\", (ctx) => {\n    console.log(ctx.previous.id);  // 123 (typed as number)\n  })\n  .build();\n```"
              }
            ]
          },
          {
            "tag": "@example",
            "name": "Using shared store",
            "content": [
              {
                "kind": "code",
                "text": "```ts\nimport { scenario } from \"@probitas-test/builder\";\n\nscenario(\"Store Example\")\n  .setup((ctx) => {\n    ctx.store.set(\"startTime\", Date.now());\n  })\n  .step(\"Check duration\", (ctx) => {\n    const start = ctx.store.get(\"startTime\") as number;\n    console.log(`Elapsed: ${Date.now() - start}ms`);\n  })\n  .build();\n```"
              }
            ]
          }
        ]
      },
