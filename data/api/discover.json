        {
          "id": 5199,
          "name": "discoverScenarioFiles",
          "variant": "signature",
          "kind": 4096,
          "flags": {},
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Discover scenario files from paths (files or directories).\n\nHandles two input types:\n- **File path**: Returns the file directly (no pattern matching)\n- **Directory path**: Scans using include/exclude patterns"
              }
            ],
            "blockTags": [
              {
                "tag": "@returns",
                "content": [
                  {
                    "kind": "text",
                    "text": "Array of absolute file paths, sorted alphabetically"
                  }
                ]
              },
              {
                "tag": "@remarks",
                "content": [
                  {
                    "kind": "text",
                    "text": "- Requires "
                  },
                  {
                    "kind": "code",
                    "text": "`--allow-read`"
                  },
                  {
                    "kind": "text",
                    "text": " permission\n- Non-existent paths are silently skipped\n- Duplicate files are automatically deduplicated\n- Output is always sorted for deterministic ordering"
                  }
                ]
              },
              {
                "tag": "@example",
                "name": "Discover from directories",
                "content": [
                  {
                    "kind": "code",
                    "text": "```ts\nimport { discoverScenarioFiles } from \"@probitas-test/discover\";\n\n// Use default patterns (*.probitas.ts)\nconst files = await discoverScenarioFiles([\"./tests\", \"./integration\"]);\n```"
                  }
                ]
              },
              {
                "tag": "@example",
                "name": "Discover with custom patterns",
                "content": [
                  {
                    "kind": "code",
                    "text": "```ts\nconst files = await discoverScenarioFiles([\"./src\"], {\n  includes: [\"**/*.test.ts\", \"**/*.spec.ts\"],\n  excludes: [\"**/__fixtures__/**\"]\n});\n```"
                  }
                ]
              },
              {
                "tag": "@example",
                "name": "Mixed files and directories",
                "content": [
                  {
                    "kind": "code",
                    "text": "```ts\nconst files = await discoverScenarioFiles([\n  \"./tests/\",           // Scan directory\n  \"./smoke.probitas.ts\" // Include specific file\n]);\n```"
                  }
                ]
              }
            ]
          },
