              {
                "kind": "text",
                "text": "Callback invoked during discovery to report progress.\n\nCalled when processing each path (file or directory) and after\ncompleting pattern matching within a directory. This allows CLI\napplications to display real-time progress feedback."
              }
            ],
            "blockTags": [
              {
                "tag": "@example",
                "content": [
                  {
                    "kind": "code",
                    "text": "```ts\nawait discoverScenarioFiles([\"./scenarios\"], {\n  onProgress: ({ currentPath, filesFound }) => {\n    console.log(`Discovering: ${currentPath} (${filesFound} files found)`);\n  },\n});\n```"
                  }
                ]
              }
            ]
